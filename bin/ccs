#!/usr/bin/env bash
# ccs — Claude Code profile switcher. See docs/adr/0001-profile-per-config-directory.md.
# Each profile is a directory; launching sets CLAUDE_CONFIG_DIR and env vars for one process.
# Written for the bash 3.2 that ships with macOS: no associative arrays, no mapfile.

set -euo pipefail

CCS_HOME="${CCS_HOME:-$HOME/.claude-profiles}"
CLAUDE_BIN="${CCS_CLAUDE_BIN:-claude}"
RESERVED="list ls new edit default env doctor import link which help"

# Provider-selection vars cleared before a profile's own vars apply, so a Bedrock
# export in the parent shell cannot leak into a personal profile. Secrets are not cleared.
PROVIDER_VARS="CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
AWS_PROFILE AWS_REGION ANTHROPIC_BASE_URL ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL
ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL
CLAUDE_CONFIG_DIR"

die() { echo "ccs: $*" >&2; exit 1; }

valid_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
  case " $RESERVED " in *" $1 "*) return 1 ;; esac
}

profile_dir() { echo "$CCS_HOME/$1"; }

profile_exists() { [[ -f "$CCS_HOME/$1/profile.env" ]]; }

# A "native" profile uses the stock ~/.claude and ~/.claude.json, so CLAUDE_CONFIG_DIR stays unset.
is_native() { [[ -f "$CCS_HOME/$1/native" ]]; }

default_profile() { [[ -f "$CCS_HOME/.default" ]] && cat "$CCS_HOME/.default" || true; }

# Walk up from $PWD looking for a .claude-profile pin file.
pinned_profile() {
  local d="$PWD"
  while :; do
    if [[ -f "$d/.claude-profile" ]]; then
      tr -d '[:space:]' < "$d/.claude-profile"
      return
    fi
    [[ "$d" == "/" ]] && return
    d="$(dirname "$d")"
  done
}

resolve_profile() {
  local p
  p="$(pinned_profile)"
  [[ -n "$p" ]] && { echo "$p"; return; }
  [[ -n "${CCS_PROFILE:-}" ]] && { echo "$CCS_PROFILE"; return; }
  default_profile
}

# Print KEY<TAB>VALUE for each assignment in profile.env. The file is parsed, never sourced.
read_env() {
  local file="$1" line key val n=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* ]] && continue
    line="${line#export }"
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || die "$file:$n: expected KEY=VALUE"
    key="${BASH_REMATCH[1]}"
    val="${BASH_REMATCH[2]}"
    if [[ "$val" =~ ^\"(.*)\"$ || "$val" =~ ^\'(.*)\'$ ]]; then
      val="${BASH_REMATCH[1]}"
    fi
    printf '%s\t%s\n' "$key" "$val"
  done < "$file"
}

apply_profile_env() {
  local name="$1" key val
  for key in $PROVIDER_VARS; do unset "$key"; done
  while IFS=$'\t' read -r key val; do
    export "$key=$val"
  done < <(read_env "$(profile_dir "$name")/profile.env")
  is_native "$name" || export CLAUDE_CONFIG_DIR="$(profile_dir "$name")/config"
  export CCS_PROFILE="$name"
}

# Symlink every item in shared/ into a profile's config dir. Skills link one by one so a
# profile can hold its own skills next to the shared ones. Never replaces a real file.
link_shared() {
  local cfg="$(profile_dir "$1")/config" shared="$CCS_HOME/shared" item base
  [[ -d "$shared" ]] || return 0
  mkdir -p "$cfg/skills"
  for item in "$shared"/* "$shared"/.[!.]*; do
    [[ -e "$item" ]] || continue
    base="$(basename "$item")"
    if [[ "$base" == "skills" ]]; then
      for item in "$shared"/skills/*; do
        [[ -e "$item" ]] || continue
        link_one "$item" "$cfg/skills/$(basename "$item")"
      done
    else
      link_one "$item" "$cfg/$base"
    fi
  done
}

link_one() {
  local src="$1" dst="$2"
  if [[ -L "$dst" ]]; then
    ln -sfn "$src" "$dst"
  elif [[ -e "$dst" ]]; then
    echo "ccs: skip $dst (a real file is there; shared copy not linked)" >&2
  else
    ln -s "$src" "$dst"
  fi
}

cmd_list() {
  local def cur d name mark
  def="$(default_profile)"
  cur="$(resolve_profile)"
  [[ -d "$CCS_HOME" ]] || { echo "No profiles yet. Try: ccs import, or ccs new <name>"; return; }
  for d in "$CCS_HOME"/*/; do
    name="$(basename "$d")"
    [[ "$name" == "shared" ]] && continue
    profile_exists "$name" || continue
    mark="  "
    [[ "$name" == "$cur" ]] && mark="* "
    printf '%s%s' "$mark" "$name"
    [[ "$name" == "$def" ]] && printf ' (default)'
    is_native "$name" && printf ' [~/.claude]'
    printf '\n'
  done
}

cmd_new() {
  local name="${1:-}" from="" dir src
  [[ -n "$name" ]] || die "usage: ccs new <name> [--from <profile>]"
  shift
  if [[ "${1:-}" == "--from" ]]; then
    from="${2:-}"
    [[ -n "$from" ]] || die "--from needs a profile name"
    profile_exists "$from" || die "no profile '$from'"
  fi
  valid_name "$name" || die "bad profile name '$name' (letters, digits, . _ -; not a command name)"
  [[ "$name" == "shared" ]] && die "'shared' is reserved"
  profile_exists "$name" && die "profile '$name' already exists"

  dir="$(profile_dir "$name")"
  mkdir -p "$dir/config/skills" "$CCS_HOME/shared"

  if [[ -n "$from" ]]; then
    src="$(profile_dir "$from")"
    cp "$src/profile.env" "$dir/profile.env"
    if is_native "$from"; then
      [[ -f "$HOME/.claude/settings.json" ]] && cp "$HOME/.claude/settings.json" "$dir/config/settings.json"
    else
      [[ -f "$src/config/settings.json" ]] && cp "$src/config/settings.json" "$dir/config/settings.json"
      # Copy the profile's own skills; shared ones are re-linked below.
      for s in "$src"/config/skills/*; do
        [[ -d "$s" && ! -L "$s" ]] && cp -R "$s" "$dir/config/skills/"
      done
    fi
  else
    cat > "$dir/profile.env" <<'EOF'
# Env vars for this profile. KEY=VALUE per line. No secrets: AWS credentials
# come from ~/.aws or SSO, claude.ai login from /login inside the profile.
#
# Bedrock example:
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_PROFILE=my-sso-profile
# AWS_REGION=us-east-1
# ANTHROPIC_MODEL=us.anthropic.claude-opus-5-5-v1:0
EOF
  fi
  link_shared "$name"
  echo "Created profile '$name' at $dir"
  echo "MCP servers live in the profile's own config. Add one with:"
  echo "  ccs $name mcp add -s user <server> -- <command>"
}

cmd_import() {
  local dir="$CCS_HOME/default"
  profile_exists default && die "profile 'default' already exists"
  mkdir -p "$dir" "$CCS_HOME/shared"
  touch "$dir/native"
  cat > "$dir/profile.env" <<'EOF'
# The 'default' profile runs Claude Code on your existing ~/.claude, untouched.
# Note: env in ~/.claude/settings.json still wins over values set here.
EOF
  [[ -n "$(default_profile)" ]] || echo default > "$CCS_HOME/.default"
  echo "Imported ~/.claude as profile 'default'. Nothing in ~/.claude changed."
}

cmd_default() {
  local name="${1:-}"
  [[ -n "$name" ]] || { default_profile; return; }
  profile_exists "$name" || die "no profile '$name'"
  echo "$name" > "$CCS_HOME/.default"
}

cmd_env() {
  local name="${1:-$(resolve_profile)}" key val
  [[ -n "$name" ]] || die "no profile given and no default set"
  profile_exists "$name" || die "no profile '$name'"
  for key in $PROVIDER_VARS; do echo "unset $key"; done
  while IFS=$'\t' read -r key val; do
    printf 'export %s=%q\n' "$key" "$val"
  done < <(read_env "$(profile_dir "$name")/profile.env")
  is_native "$name" || printf 'export CLAUDE_CONFIG_DIR=%q\n' "$(profile_dir "$name")/config"
  printf 'export CCS_PROFILE=%q\n' "$name"
}

cmd_edit() {
  local name="${1:-$(resolve_profile)}"
  profile_exists "$name" || die "no profile '$name'"
  "${EDITOR:-vi}" "$(profile_dir "$name")/profile.env"
}

cmd_link() {
  local d name
  for d in "$CCS_HOME"/*/; do
    name="$(basename "$d")"
    [[ "$name" == "shared" ]] && continue
    profile_exists "$name" && ! is_native "$name" && link_shared "$name"
  done
  echo "Shared items linked into every profile."
}

cmd_doctor() {
  local name="${1:-$(resolve_profile)}" dir bad=0 l keys
  [[ -n "$name" ]] || die "no profile given and no default set"
  profile_exists "$name" || die "no profile '$name'"
  dir="$(profile_dir "$name")"
  echo "Profile: $name"

  keys="$(read_env "$dir/profile.env" | cut -f1 | tr '\n' ' ')" || { echo "  ✗ profile.env does not parse"; return 1; }
  echo "  ✓ profile.env parses (${keys:-no vars})"

  if is_native "$name"; then
    echo "  ✓ native: uses ~/.claude"
  else
    while IFS= read -r l; do
      echo "  ✗ broken symlink: $l"; bad=1
    done < <(find "$dir/config" -maxdepth 2 -type l ! -exec test -e {} \; -print)
    [[ $bad -eq 0 ]] && echo "  ✓ no broken symlinks"
  fi

  if [[ " $keys " == *" CLAUDE_CODE_USE_BEDROCK "* ]]; then
    [[ " $keys " == *" AWS_REGION "* ]] || { echo "  ✗ Bedrock profile without AWS_REGION"; bad=1; }
    [[ " $keys " == *" AWS_PROFILE "* ]] || echo "  ! Bedrock profile without AWS_PROFILE (uses the default AWS chain)"
  fi
  command -v "$CLAUDE_BIN" >/dev/null || { echo "  ✗ '$CLAUDE_BIN' not on PATH"; bad=1; }
  return $bad
}

cmd_help() {
  cat <<'EOF'
ccs — Claude Code profile switcher

  ccs [claude args…]             start claude with the resolved profile
  ccs <profile> [claude args…]   start claude with <profile>
  ccs list                       list profiles (* = resolved, (default))
  ccs new <name> [--from <p>]    make a profile, optionally cloned
  ccs import                     add your existing ~/.claude as profile 'default'
  ccs default [<name>]           show or set the default profile
  ccs env [<name>]               print exports: eval "$(ccs env work)"
  ccs edit [<name>]              edit the profile's profile.env
  ccs link                       re-link ~/.claude-profiles/shared into all profiles
  ccs doctor [<name>]            check a profile
  ccs which                      print the resolved profile

Resolution order: argument, .claude-profile file (walking up), $CCS_PROFILE, default.
EOF
}

launch() {
  local name="$1"; shift
  profile_exists "$name" || die "no profile '$name' (see: ccs list)"
  apply_profile_env "$name"
  exec "$CLAUDE_BIN" "$@"
}

main() {
  local first="${1:-}"
  case "$first" in
    list|ls) cmd_list ;;
    new)     shift; cmd_new "$@" ;;
    import)  cmd_import ;;
    default) shift; cmd_default "$@" ;;
    env)     shift; cmd_env "$@" ;;
    edit)    shift; cmd_edit "$@" ;;
    link)    cmd_link ;;
    doctor)  shift; cmd_doctor "$@" ;;
    which)   resolve_profile ;;
    help|-h|--help) cmd_help ;;
    *)
      if [[ -n "$first" && "$first" != -* ]] && profile_exists "$first"; then
        shift; launch "$first" "$@"
      else
        local p; p="$(resolve_profile)"
        [[ -n "$p" ]] || die "no profile given and no default set (try: ccs import)"
        launch "$p" "$@"
      fi
      ;;
  esac
}

main "$@"
